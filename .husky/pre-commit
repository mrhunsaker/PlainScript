#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run ESLint on staged files
echo "📝 Linting staged files..."
npx lint-staged

if [ $? -ne 0 ]; then
  echo "❌ Linting failed. Fix errors above and try again."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
